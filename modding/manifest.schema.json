{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Minsky Mod Manifest",
  "type": "object",
  "required": ["id", "version"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "contributes": {
      "type": "object",
      "properties": {
        "menus": {
          "type": "object",
          "properties": {
            "topLevel": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "label"],
                "properties": {
                  "id": { "type": "string" },
                  "label": { "type": "string" },
                  "after": { "type": "string" }
                }
              }
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["menu", "label", "command"],
                "properties": {
                  "menu": { "type": "string" },
                  "label": { "type": "string" },
                  "command": { "type": "string" }
                }
              }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string" },
              "route": { "type": "string" },
              "window": {
                "type": "object",
                "properties": {
                  "width": { "type": "number" },
                  "height": { "type": "number" },
                  "title": { "type": "string" }
                }
              }
            }
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "module"],
            "properties": {
              "path": { "type": "string" },
              "module": { "type": "string" }
            }
          }
        },
        "ipc": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["channel"],
            "properties": {
              "channel": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
